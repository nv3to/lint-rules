; lint-rules: a Please plugin that runs linters as ordinary plz tests.
; Consumers load it with [Plugin "lint"] and set the tool keys below; a
; language whose tool is unset is skipped.

[Please]
Version = >=17.32.0

[PluginDefinition]
Name = lint

[PluginConfig "gofmt_tool"]
Help = Build label or path of gofmt, e.g. //third_party/go:toolchain|gofmt. Unset skips the gofmt check.
Optional = true
Inherit = true

[PluginConfig "go_tool"]
Help = Build label or path of go. repo_lint() runs `go vet ./...` with it, and repolint() compiles the built-in checks with it. Unset skips vet, and repolint() fails.
Optional = true
Inherit = true

[PluginConfig "pyflakes_tool"]
Help = Build label or path of a pyflakes executable. Unset skips the pyflakes check.
Optional = true
Inherit = true

[PluginConfig "rule"]
Help = A custom linter run by every lint(), as "<name> <exts> <tool> [args...]", e.g. "shellcheck .sh,.bash //third_party/tools:shellcheck -x". Creates lint_<name>, which fails when the tool exits non-zero; the coverage guard then covers those extensions too.
Repeatable = true
Optional = true
Inherit = true

[PluginConfig "label"]
Help = Label put on every lint test, so `plz test --include <label>` runs lint alone.
DefaultValue = lint
Inherit = true

[PluginConfig "exclude"]
Help = Repo-relative path prefixes the coverage guard ignores (vendored or generated sources). testdata/ is always ignored.
Repeatable = true
Optional = true
Inherit = true
