"""lint-rules: linters as ordinary plz tests.

lint() goes in every BUILD file that owns sources; repo_lint() goes once in
the root BUILD file. Tools come from the plugin config ([Plugin "lint"]), so
each repo supplies its own pinned gofmt, go and pyflakes.

Custom rules come in two forms: a `Rule` config line applies a linter to
every lint() package, and lint_rule() adds one to a single package.

repolint() builds the plugin's own checks (tools/repolint) with the repo's go,
for a `Rule` line or lint_rule() to use as a tool.
"""


def _config_rules():
    """Parses the `Rule` config lines: "<name> <exts> <tool> [args...]"."""
    rules = []
    for spec in CONFIG.LINT.RULE or []:
        parts = [p for p in spec.split(" ") if p]
        if len(parts) < 3:
            fail('lint: Rule must be "<name> <exts> <tool> [args...]", got "%s"' % spec)
        rules += [{
            "name": parts[0],
            "exts": [e.lstrip(".") for e in parts[1].split(",") if e],
            "tool": parts[2],
            "args": parts[3:],
        }]
    return rules


def _exts():
    """Every extension lint() globs and the coverage guard checks."""
    exts = ["go", "py"]
    for rule in _config_rules():
        exts += [e for e in rule["exts"] if e not in exts]
    return exts


def lint_rule(name:str, srcs:list, tool:str, args:list=[], fail_on_output:bool=False,
              labels:list=[]):
    """A custom lint check: runs `tool args... files...` as a plz test.

    Creates `lint_<name>`, which fails when the tool exits non-zero. lint()
    calls this for every `Rule` config line; call it directly for a check
    that only one package needs.

    Args:
      name (str): Name of the rule; the test is `lint_<name>`.
      srcs (list): Files to check.
      tool (str): Build label or path of the linter.
      args (list): Arguments placed before the files.
      fail_on_output (bool): Also fail when the tool prints anything, for
                             tools that report findings but exit zero.
      labels (list): Extra labels, added to the lint label and the name.
    """
    cmd = " ".join(["$TOOLS"] + args + ["$DATA"])
    if fail_on_output:
        cmd = 'out=`%s`; rc=$?; if [ -n "$out" ]; then echo "$out"; exit 1; fi; exit $rc' % cmd
    return gentest(
        name = "lint_" + name,
        data = srcs,
        labels = [CONFIG.LINT.LABEL, name] + labels,
        no_test_output = True,
        test_cmd = cmd,
        test_tools = [tool],
    )


def lint(srcs:list=None, visibility:list=None):
    """Lints this package's own sources.

    Creates, each only when there are matching sources and its tool is
    configured:
      lint_gofmt     fails when `gofmt -l` names a file, and prints the diff;
      lint_pyflakes  fails on any pyflakes finding;
      lint_<name>    one per `Rule` config line, over that rule's extensions.
    It also creates `lint`, a filegroup of the linted sources, which
    repo_lint() depends on: that is how it knows what is covered and when to
    re-run.

    Args:
      srcs (list): Files to lint. Defaults to every file in the package
                   directory with a linted extension (*.go, *.py and the
                   extensions of the configured rules); a package that owns
                   sub-directories passes e.g. glob(["**/*.py"]).
      visibility (list): Visibility of the `lint` filegroup.
    """
    files = srcs if srcs is not None else glob(["*." + e for e in _exts()], allow_empty = True)
    go_srcs = [f for f in files if f.endswith(".go")]
    py_srcs = [f for f in files if f.endswith(".py")]
    label = CONFIG.LINT.LABEL
    if go_srcs and CONFIG.LINT.GOFMT_TOOL:
        gentest(
            name = "lint_gofmt",
            data = go_srcs,
            labels = [label, "gofmt"],
            no_test_output = True,
            test_cmd = 'out=`$TOOLS -l $DATA` || exit 1; if [ -n "$out" ]; then echo "gofmt: run gofmt -w on:"; echo "$out"; $TOOLS -d $DATA; exit 1; fi',
            test_tools = [CONFIG.LINT.GOFMT_TOOL],
        )
    if py_srcs and CONFIG.LINT.PYFLAKES_TOOL:
        gentest(
            name = "lint_pyflakes",
            data = py_srcs,
            labels = [label, "pyflakes"],
            no_test_output = True,
            test_cmd = "$TOOLS $DATA",
            test_tools = [CONFIG.LINT.PYFLAKES_TOOL],
        )
    for rule in _config_rules():
        rule_srcs = [f for f in files if any([f.endswith("." + e) for e in rule["exts"]])]
        if rule_srcs:
            lint_rule(
                name = rule["name"],
                srcs = rule_srcs,
                tool = rule["tool"],
                args = rule["args"],
            )
    return filegroup(
        name = "lint",
        srcs = files,
        visibility = visibility or ["//:all"],
    )


def repo_lint(name:str="repo_lint", packages:list=[]):
    """The repo-wide half: `go vet` and the coverage guard.

    vet needs the whole module and the Go caches, so this test runs locally,
    outside the sandbox, against the repo root. It depends on every listed
    package's `lint` filegroup, so it re-runs whenever a linted source
    changes.

    The coverage guard fails when a tracked file with a linted extension
    (*.go, *.py and the extensions of the configured rules; outside testdata/
    and the configured excludes) is in none of those filegroups: its package
    does not call lint(), or is missing from `packages`. A new package
    therefore cannot skip lint silently.

    Args:
      name (str): Name of the test.
      packages (list): Every package that calls lint(), as "//path" ("//" for
                       the root package).
    """
    tools = {"guard": "///lint//tools:repo_lint"}
    args = ""
    if CONFIG.LINT.GO_TOOL:
        tools["go"] = CONFIG.LINT.GO_TOOL
        args = " --go $TOOLS_GO"
    for ext in _exts():
        args += " --ext " + ext
    for prefix in CONFIG.LINT.EXCLUDE or []:
        args += " --exclude " + prefix
    return gentest(
        name = name,
        data = [p + ":lint" for p in packages],
        labels = [CONFIG.LINT.LABEL, "vet"],
        local = True,
        no_test_output = True,
        pass_env = ["HOME", "PATH", "GOPATH", "GOMODCACHE", "GOCACHE", "GOPROXY", "GOFLAGS"],
        sandbox = False,
        test_cmd = "$TOOLS_GUARD" + args,
        test_tools = tools,
    )


def repolint(name:str="repolint", visibility:list=["PUBLIC"]):
    """Builds the plugin's own checks, the program in tools/repolint.

    The program is Go source that imports only the standard library. It is
    compiled with the repo's go (the go_tool config key), so building it
    downloads nothing. Use the target as the tool of a `Rule` config line or
    of lint_rule(); the README lists the checks and their arguments.

    Args:
      name (str): Name of the target, which is the built program.
      visibility (list): Visibility of the target. Defaults to PUBLIC, as a
                         `Rule` line names it from every package.
    """
    if not CONFIG.LINT.GO_TOOL:
        fail('repolint: set GoTool in [Plugin "lint"] to the go that builds the checks')
    cmd = " && ".join([
        # go finds its GOROOT from the path of its own binary, which sits in the
        # toolchain's directory, so no GOROOT is set. Relative paths, of go
        # and of the output, are made absolute before the cd.
        'go="$TOOL"',
        'case "$go" in /*) ;; *) go="$PWD/$go" ;; esac',
        'out="$OUT"',
        'case "$out" in /*) ;; *) out="$PWD/$out" ;; esac',
        # Where the plugin's sources land depends on the plugin's subrepo: find go.mod.
        'for f in $SRCS; do case "$f" in go.mod|*/go.mod) dir="${f%go.mod}" ;; esac; done',
        'export GOCACHE="$TMP_DIR/gocache" GOPATH="$TMP_DIR/gopath" GOMODCACHE="$TMP_DIR/gomodcache"',
        "export GOTOOLCHAIN=local GOENV=off GOFLAGS=-mod=mod GOPROXY=off GOWORK=off CGO_ENABLED=0",
        '(cd "${dir:-.}" && "$go" build -trimpath -buildvcs=false -o "$out" .)',
    ])
    return genrule(
        name = name,
        srcs = ["///lint//tools/repolint:srcs"],
        outs = [name],
        binary = True,
        cmd = cmd,
        tools = [CONFIG.LINT.GO_TOOL],
        visibility = visibility,
    )
